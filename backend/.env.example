# ===========================================
# IT Service Desk - Environment Configuration
# ===========================================

# Application
APP_NAME="IT Service Desk"
APP_VERSION="1.0.0"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Server
HOST=0.0.0.0
PORT=8000

# Admin Defaults (For Seed Script)
ADMIN_EMAIL=admin@cskh.vn
ADMIN_PASSWORD=Admin@123
ADMIN_FULL_NAME="System Administrator"

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/servicedesk
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI Engine (choose one: openai or google)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key
GOOGLE_API_KEY=your-google-api-key
AI_MODEL_NAME=gpt-4o-mini
AI_TIMEOUT_SECONDS=4
AI_FALLBACK_CATEGORY=Uncategorized
AI_FALLBACK_PRIORITY=P3
AI_CONFIDENCE_THRESHOLD=0.4

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# SLA Default Times (in minutes)
SLA_P1_RESPONSE=15
SLA_P1_RESOLVE=60
SLA_P2_RESPONSE=30
SLA_P2_RESOLVE=240
SLA_P3_RESPONSE=120
SLA_P3_RESOLVE=1440
SLA_P4_RESPONSE=480
SLA_P4_RESOLVE=4320

# Customer Timeout (in hours)
CUSTOMER_REMINDER_HOURS=48
CUSTOMER_AUTO_CLOSE_HOURS=72
